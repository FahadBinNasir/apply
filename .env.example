# ==============================================================================
# WhatsApp Job Agent Environment Configuration Template
# Copy this file to .env or paste into Portainer Stack Environment Editor
# ==============================================================================

# Application & Host Configuration
APP_ENV=production
APP_PORT=8080

# Single-User Authentication (Required)
# Generate with python: python -c "import bcrypt; print(bcrypt.hashpw(b'YourPasswordHere', bcrypt.gensalt()).decode())"
DASHBOARD_PASSWORD_HASH=

# Cryptographic Keys (Required)
# Generate 32-byte hex or base64 strings:
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
WEBHOOK_SECRET=

# Fernet Key for encrypting OAuth tokens at rest:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Free-Tier LLM Providers (Google AI Studio & Groq)
# Get free key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_SMART=gemini-2.5-flash

# Optional free fallback at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Cloud OAuth Client (Gmail API - scope gmail.send)
# Create in Google Cloud Console > APIs & Services > Credentials
# Ensure consent screen is published as "In production" (personal testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://apply.fahadbinnasir.tech/oauth/google/callback
GMAIL_REFRESH_TOKEN_ENC=

# Optional SMTP Fallback (alternative to Gmail API)
# Use a 16-character App Password from Google Account > Security > 2-Step Verification
MAIL_BACKEND=gmail_api
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sending Safety Controls (Defaults keep sending in dry-run mode)
SEND_ENABLED=false
DAILY_SEND_CAP=25
MIN_GAP_SECONDS=60

# WhatsApp Intake Configuration
WAHA_API_KEY=generate_random_secret_string_here
WATCHED_CHATS=

# Testing & Development
ENABLE_SIMULATOR=false
NOW_OVERRIDE=
